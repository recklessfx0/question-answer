# Example environment configuration — copy outside public/ at install time.
# NEVER commit a real .env file or real credentials.

APP_ENV=production
APP_URL=https://example.com
APP_KEY=CHANGE_ME_GENERATE_32_BYTE_BASE64_KEY_AT_INSTALL
APP_DEFAULT_LOCALE=en

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=questionanswer
DB_USERNAME=qa_app
DB_PASSWORD=CHANGE_ME_AT_INSTALL

CACHE_DRIVER=file

MAIL_TRANSPORT=log
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=QuestionAnswer
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_ENCRYPTION=smtps
SMTP_USERNAME=CHANGE_ME_AT_INSTALL
SMTP_PASSWORD=CHANGE_ME_AT_INSTALL
SMTP_ALLOW_LOCAL_RELAY=false
